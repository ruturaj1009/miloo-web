# -----------------------------------------------------------------------------
# Miloo Web Application — Environment Configuration Template
# Copy this file to .env.local for local development.
# In production (e.g. Vercel, Railway, AWS), define these in your deployment dashboard.
# -----------------------------------------------------------------------------

# Public domain of the deployed web application (used for canonical URLs, sitemaps, and OpenGraph)
NEXT_PUBLIC_SITE_URL=https://miloo.app

# Backend API endpoint (if connecting to Miloo backend services)
NEXT_PUBLIC_API_URL=https://api.miloo.app

# Mobile store listings
NEXT_PUBLIC_APP_STORE_URL=https://apps.apple.com/app/miloo
NEXT_PUBLIC_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.miloo.app
